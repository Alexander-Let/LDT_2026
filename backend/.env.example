# Адрес HTTP-сервера
HTTP_ADDR=:8080

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://finni:finni@localhost:5432/finni?sslmode=disable

# Окружение: dev | prod
# В dev одноразовый код родителя возвращается в поле dev_code ответа POST /v1/parents/otp
APP_ENV=dev

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info
